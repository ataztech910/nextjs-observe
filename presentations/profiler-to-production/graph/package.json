{
  "name": "profiler-to-production-graph-deck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "python3 generate.py",
    "dev": "npm run generate && vite --host 127.0.0.1 --port 4349 --strictPort",
    "build": "npm run generate && tsc --noEmit && vite build && node pack.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4349 --strictPort",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "framer-motion": "14.1.0",
    "lucide-react": "0.575.0",
    "qrcode.react": "4.2.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "8.1.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "22.20.5"
  },
  "overrides": {
    "rolldown": "1.2.1"
  }
}
