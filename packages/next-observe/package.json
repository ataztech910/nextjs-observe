{
  "name": "next-observe",
  "version": "0.0.1",
  "description": "OpenTelemetry observability for Next.js — client, server and your own code via 'use observe'",
  "license": "MIT",
  "type": "module",
  "bin": {
    "next-observe": "./dist/bin.js",
    "nxo": "./dist/bin.js"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./loader": "./dist/transform/loader.cjs",
    "./collector": {
      "types": "./dist/collector/index.d.ts",
      "default": "./dist/collector/index.js"
    },
    "./debug": {
      "types": "./dist/debug/index.d.ts",
      "default": "./dist/debug/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "default": "./dist/agents/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && npm --prefix ui run build",
    "ui:install": "npm --prefix ui install",
    "ui:dev": "npm --prefix ui run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix ui run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/core": "^8.0.6",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-document-load": "^0.67.0",
    "@opentelemetry/instrumentation-fetch": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@vercel/otel": "^2.1.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@google/adk": ">=2.1.0",
    "@kitana-sdk/adk": ">=0.1.10",
    "@opentelemetry/api": "^1.9.0",
    "next": ">=16.0.0"
  },
  "devDependencies": {
    "@google/adk": "^2.1.0",
    "@google/genai": "^2.24.0",
    "@kitana-sdk/adk": "^0.1.10",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@types/node": "^26.6.3",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependenciesMeta": {
    "@google/adk": {
      "optional": true
    },
    "@kitana-sdk/adk": {
      "optional": true
    }
  }
}
