{
  "name": "next-observe",
  "version": "0.3.7",
  "description": "The APM agent for Next.js: OpenTelemetry for server, browser and your own code via 'use observe'. It only collects and sends; the UI and the AI agents are in the next-observer observer (npx next-observer dev).",
  "license": "MIT",
  "author": "Andrei Tazetdinov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ataztech910/nextjs-observe.git",
    "directory": "packages/next-observe"
  },
  "homepage": "https://github.com/ataztech910/nextjs-observe#readme",
  "bugs": {
    "url": "https://github.com/ataztech910/nextjs-observe/issues"
  },
  "keywords": [
    "nextjs",
    "next",
    "opentelemetry",
    "otel",
    "observability",
    "tracing",
    "monitoring",
    "instrumentation",
    "apm",
    "apm-agent"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./loader": "./dist/transform/loader.cjs",
    "./agents": {
      "types": "./dist/agents.d.ts",
      "default": "./dist/agents.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@babel/core": "^8.0.6",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-document-load": "^0.67.0",
    "@opentelemetry/instrumentation-fetch": "^0.222.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@vercel/otel": "^2.1.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "next": ">=16.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@types/node": "^26.6.3",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
